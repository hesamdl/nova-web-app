{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-web-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6ca52c15-e3d3-41d9-a088-ccc4f23e536c","database_name": "d1db-nova-web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7acca3538f6d4b89a0bf9c2d0f6c6086" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
